# ── Backend ──────────────────────────────────────────────
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://dst:dst@localhost:5432/dst  # only needed Phase 6+

# ── Deriv OAuth2 (register at https://api.deriv.com/dashboard) ────
DERIV_CLIENT_ID=           # OAuth2 client_id — different from APP_ID
DERIV_APP_ID=1089          # App ID for Deriv-App-ID header
DERIV_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Affiliate (from https://affiliate.deriv.com) ─────────
AFFILIATE_ID=              # e.g. CU303219
AFFILIATE_SIDC=            # session GUID from partner dashboard
AFFILIATE_CAMPAIGN=dst

# ── Claude API (https://console.anthropic.com) ───────────
ANTHROPIC_API_KEY=

# ── Frontend (VITE_ prefix required) ─────────────────────
VITE_DERIV_CLIENT_ID=      # same as DERIV_CLIENT_ID above
VITE_DERIV_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AFFILIATE_ID=
VITE_AFFILIATE_SIDC=
VITE_AFFILIATE_CAMPAIGN=dst
